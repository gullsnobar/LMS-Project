<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Activate Your Account</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f6f8;
        font-family: Arial, Helvetica, sans-serif;
      }

      .container {
        max-width: 600px;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      }

      .header {
        background-color: #0d6efd;
        color: #ffffff;
        padding: 20px;
        text-align: center;
      }

      .header h1 {
        margin: 0;
        font-size: 24px;
      }

      .content {
        padding: 30px;
        color: #333333;
      }

      .content h2 {
        margin-top: 0;
        font-size: 22px;
      }

      .content p {
        line-height: 1.6;
        font-size: 15px;
      }

      .code-box {
        margin: 30px 0;
        padding: 15px;
        background-color: #f1f3f5;
        border: 1px dashed #0d6efd;
        text-align: center;
        font-size: 28px;
        font-weight: bold;
        letter-spacing: 4px;
        color: #0d6efd;
      }

      .footer {
        background-color: #f8f9fa;
        padding: 15px;
        text-align: center;
        font-size: 13px;
        color: #6c757d;
      }

      .footer p {
        margin: 5px 0;
      }

      @media (max-width: 600px) {
        .content {
          padding: 20px;
        }

        .code-box {
          font-size: 24px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- Header -->
      <div class="header">
        <h1>LMS Account Activation</h1>
      </div>

      <!-- Content -->
      <div class="content">
        <h2>Hello <%= name %>,</h2>

        <p>
          Thank you for registering with our LMS platform. To complete your
          registration, please use the activation code below.
        </p>

        <div class="code-box">
          <%= activationCode %>
        </div>

        <p>
          This activation code is valid for <strong>15 minutes</strong>.
          If you did not request this account, you can safely ignore this email.
        </p>

        <p>
          For security reasons, please do not share this code with anyone.
        </p>

        <p>
          If you have any questions or need help, feel free to contact our
          support team.
        </p>

        <p>
          Best regards,<br />
          <strong>LMS Team</strong>
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>© <%= new Date().getFullYear() %> LMS. All rights reserved.</p>
        <p>This is an automated email. Please do not reply.</p>
      </div>
    </div>
  </body>
</html>
