{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "./",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,           // enable source maps to see errors in ts-node-dev
    "noEmitOnError": false        // ensure ts-node-dev runs even if TS type errors exist
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
